{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "static/js/orcid",
    "rootDir": "src/orcid",
    "removeComments": false,
    "esModuleInterop": true
  },
  "include": ["src/orcid/**/*.ts"],
  "exclude": ["node_modules", "public"]
}


